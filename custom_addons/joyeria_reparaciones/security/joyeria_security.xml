<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================= -->
        <!-- GRUPO: GESTIÓN ESTADO REPARACIONES                       -->
        <!-- ========================================================= -->

        <record id="grupo_gestion_estado_reparacion" model="res.groups">
            <field name="name">Gestión Estado Reparaciones</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <!--
            Usuario que trabaja con las reparaciones:
            - Leer: SI
            - Crear: SI
            - Modificar: SI
            - Eliminar: NO
        -->
        <record id="joyeria_reparacion_estado_rule" model="ir.model.access">
            <field name="name">Acceso Gestión Estado Reparaciones</field>
            <field name="model_id" ref="model_joyeria_reparacion"/>
            <field name="group_id" ref="joyeria_reparaciones.grupo_gestion_estado_reparacion"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>


        <!-- ========================================================= -->
        <!-- GRUPO: CONSULTA REPARACIONES                              -->
        <!-- ========================================================= -->

        <record id="grupo_consulta_reparaciones" model="res.groups">
            <field name="name">Consulta Reparaciones</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <!--
            Usuario de consulta:
            - Leer: SI
            - Crear: NO
            - Modificar: NO
            - Eliminar: NO
        -->
        <record id="joyeria_reparacion_consulta_rule" model="ir.model.access">
            <field name="name">Acceso Consulta Reparaciones - Solo Lectura</field>
            <field name="model_id" ref="model_joyeria_reparacion"/>
            <field name="group_id" ref="joyeria_reparaciones.grupo_consulta_reparaciones"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>


        <!-- ========================================================= -->
        <!-- REGLA: CONSULTA PUEDE VER TODAS LAS REPARACIONES          -->
        <!-- ========================================================= -->

        <record id="joyeria_reparacion_consulta_all_rule" model="ir.rule">
            <field name="name">Consulta Reparaciones - Ver Todas</field>
            <field name="model_id" ref="model_joyeria_reparacion"/>
            <field name="groups" eval="[(4, ref('joyeria_reparaciones.grupo_consulta_reparaciones'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>

            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>


        <!-- ========================================================= -->
        <!-- PERMISOS NORMALES PARA OPERACIONES                        -->
        <!-- ========================================================= -->

        <record id="joyeria_operacion_user_rule" model="ir.model.access">
            <field name="name">Acceso Usuarios Joyeria Operacion</field>
            <field name="model_id" ref="model_joyeria_operacion"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>